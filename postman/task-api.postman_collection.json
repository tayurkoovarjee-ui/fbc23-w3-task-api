    {
      "name": "Create task: success (FR-3)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 created\", () => pm.response.to.have.status(201));",
              "pm.test(\"defaults to todo\", () => pm.expect(pm.response.json().status).to.eql(\"todo\"));",
              "pm.test(\"Location header points at the task\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/tasks/\" + pm.response.json().id));",
              "pm.collectionVariables.set(\"taskId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
