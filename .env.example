# Copy this file to .env and change the values. .env is never committed.

POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskdb

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO

# Only used when you run the API outside Docker (see README).
# Inside Compose, DATABASE_URL is built from the values above.
DATABASE_URL=postgresql+psycopg://taskuser:change-me@localhost:5432/taskdb
